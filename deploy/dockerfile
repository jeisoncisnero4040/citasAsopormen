# Imagen base
FROM ubuntu:latest

ENV DEBIAN_FRONTEND=noninteractive

# 🔧 Instalación de dependencias del sistema y PHP
RUN apt-get update && apt-get install -y \
    apache2 \
    libapache2-mod-php \
    php \
    php-cli \
    php-pear \
    php-dev \
    php-xml \
    php-mbstring \
    php-zip \
    php-curl \
    php-json \
    php-common \
    php-intl \
    php-bcmath \
    php-gd \
    php-soap \
    php-xmlrpc \
    php-odbc \
    git \
    nano \
    curl \
    unzip \
    gnupg2 \
    inotify-tools \
    && rm -rf /var/lib/apt/lists/*

# ⚙️ Instalación de drivers SQL Server
RUN curl https://packages.microsoft.com/keys/microsoft.asc | apt-key add - && \
    curl https://packages.microsoft.com/config/ubuntu/$(lsb_release -rs)/prod.list -o /etc/apt/sources.list.d/mssql-release.list && \
    apt-get update && ACCEPT_EULA=Y apt-get install -y msodbcsql18 unixodbc-dev && \
    pecl install sqlsrv pdo_sqlsrv && \
    echo "extension=sqlsrv.so" > /etc/php/*/apache2/conf.d/20-sqlsrv.ini && \
    echo "extension=pdo_sqlsrv.so" > /etc/php/*/apache2/conf.d/30-pdo_sqlsrv.ini

# 📦 Instalación de Composer
RUN curl -sS https://getcomposer.org/installer | php && \
    mv composer.phar /usr/local/bin/composer

# 📂 Directorio base
WORKDIR /var/www

# ⚔️ Clon inicial del repositorio
RUN git clone -b clinico https://github.com/jeisoncisnero4040/citasAsopormen.git clinico

# 🪶 VirtualHost Apache
COPY virtualhost.conf /etc/apache2/sites-available/000-default.conf

# 🧰 Instalación de dependencias Laravel
RUN cd clinico && composer install --no-interaction --prefer-dist --optimize-autoloader

# ⚡ Activamos mod_rewrite
RUN a2enmod rewrite

# ⚙️ Añadimos el script de escucha del repositorio
COPY git-hook-listener.sh /usr/local/bin/git-hook-listener.sh
RUN chmod +x /usr/local/bin/git-hook-listener.sh

# 🔥 Exponemos los puertos
EXPOSE 80 443

# 🏁 Arranque: Apache + Hook
CMD service apache2 start && /usr/local/bin/git-hook-listener.sh
